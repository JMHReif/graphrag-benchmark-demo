d(chain.toString());\n        }","newString":"    private String expandGraphFacts(Session session, String chunkId) {\n        List<Record> rows = session.run(\"\"\"\n                MATCH (c:Chunk {id: $chunkId})-[:MENTIONS]->(entity)\n                OPTIONAL MATCH path = (entity)-[*1..2]-(other)\n                WHERE path IS NULL OR NONE(n IN nodes(path)[1..] WHERE n:Chunk OR n = entity)\n                RETURN entity, path\n                LIMIT 60\n                \"\"\", Map.of(\"chunkId\", chunkId)).list();\n\n        // Group facts by the entity so the LLM sees \"Bug X: fixed by Y, reported by Z\" rather than a flat list.\n        Map<String, Set<String>> factsByEntity = new LinkedHashMap<>();\n\n        for (Record row : rows) {\n            Node entity = row.get(\"entity\").asNode();\n            String entityLabel = describe(entity);\n            factsByEntity.computeIfAbsent(entityLabel, k -> new LinkedHashSet<>());\n\n            Value pathValue = row.get(\"path\");\n            if (pathValue.isNull()) {\n                continue;\n            }\n            Path path = pathValue.asPath();\n            StringBuilder chain = new StringBuilder();\n            Node current = entity;\n            for (Path.Segment segment : path) {\n                Relationship rel = segment.relationship();\n                Node next = segment.start().elementId().equals(current.elementId()) ? segment.end() : segment.start();\n                boolean outgoing = rel.startNodeElementId().equals(current.elementId());\n                String arrow = outgoing ? \"-[\" + rel.type() + \"]->\" : \"<-[\" + rel.type() + \"]-\";\n                chain.append(chain.isEmpty() ? \"\" : \" \").append(arrow).append(\" \").append(describe(next));\n                current = next;\n            }\n\n            factsByEntity.get(entityLabel).add(chain.toString());\n        }","originalFile":"package com.neo4j.webinar.retrieval;\n\nimport dev.langchain4j.data.embedding.Embedding;\nimport dev.langchain4j.model.embedding.EmbeddingModel;\nimport dev.langchain4j.rag.content.Content;\nimport dev.langchain4j.rag.content.retriever.ContentRetriever;\nimport dev.langchain4j.rag.query.Query;\nimport org.neo4j.driver.Driver;\nimport org.neo4j.driver.Record;\nimport org.neo4j.driver.Session;\nimport org.neo4j.driver.types.Node;\nimport org.neo4j.driver.types.Path;\nimport org.neo4j.driver.types.Relationship;\n\nimport java.util.ArrayList;\nimport java.util.HashSet;\nimport java.util.LinkedHashMap;\nimport java.util.LinkedHashSet;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Set;\n\n/**\n * The GraphRAG retriever: this is the piece that turns plain vector RAG into\n * *graph* RAG.\n *\n * <pre>\n *   1. Embed the question.\n *   2. Vector search over :Chunk.embedding for a candidate pool slightly\n *      wider than what we'll actually use -- this is exactly what a\n *      vector-only pipeline would stop at.\n *   3. If the question names something that's actually in the graph (a\n *      product, feature, release, bug, customer, or policy), use the graph\n *      to drop candidates that aren't within two hops of it -- e.g. a\n *      question naming \"Aurora\" shouldn't pull in a Beacon release note\n *      just because it scored well on vector similarity. If nothing in the\n *      question matches a graph entity, keep the vector ranking as-is.\n *   4. For each surviving seed chunk, walk up to two hops out through the\n *      graph (Chunk -[:MENTIONS]-> entity -[any]- ...) to pull in connected\n *      facts a text chunk alone can't express: which release fixed a bug,\n *      which customers reported it (Bug -> Ticket -> Customer is two hops),\n *      whether it's still open, etc.\n *   5. Return chunk text + graph facts together as retrieved Content.\n * </pre>\n */\npublic class GraphRagContentRetriever implements ContentRetriever {\n\n    private static final String VECTOR_INDEX = \"chunkEmbeddings\";\n\n    private final Driver driver;\n    private final EmbeddingModel embeddingModel;\n    private final int maxSeedChunks;\n\n    public GraphRagContentRetriever(Driver driver, EmbeddingModel embeddingModel, int maxSeedChunks) {\n        this.driver = driver;\n        this.embeddingModel = embeddingModel;\n        this.maxSeedChunks = maxSeedChunks;\n    }\n\n    @Override\n    public List<Content> retrieve(Query query) {\n        Embedding queryEmbedding = embeddingModel.embed(query.text()).content();\n        List<Content> contents = new ArrayList<>();\n\n        try (Session session = driver.session()) {\n            List<Record> candidates = session.run(\"\"\"\n                    CALL db.index.vector.queryNodes($indexName, $k, $queryVector)\n                    YIELD node, score\n                    RETURN node.id AS id, node.text AS text, score\n                    \"\"\", Map.of(\n                    \"indexName\", VECTOR_INDEX,\n                    \"k\", maxSeedChunks + 2,\n                    \"queryVector\", queryEmbedding.vectorAsList()\n            )).list();\n\n            Set<String> namedEntityIds = findEntitiesNamedInQuestion(session, query.text());\n            List<Record> filtered = namedEntityIds.isEmpty()\n                    ? candidates\n                    : candidates.stream().filter(c -> isNearNamedEntity(session, c.get(\"id\").asString(), namedEntityIds)).toList();\n            List<Record> seeds = (filtered.isEmpty() ? candidates : filtered).stream().limit(maxSeedChunks).toList();\n\n            for (Record seed : seeds) {\n                String chunkId = seed.get(\"id\").asString();\n                String chunkText = seed.get(\"text\").asString();\n                String graphFacts = expandGraphFacts(session, chunkId);\n\n                String combined = \"Source passage [\" + chunkId + \"]: \" + chunkText +\n                        (graphFacts.isBlank() ? \"\" : \"\\nRelated graph facts:\\n\" + graphFacts);\n\n                contents.add(Content.from(combined));\n            }\n        }\n        return contents;\n    }\n\n    /** Finds graph entities whose name/id/version is literally named in the question text. */\n    private Set<String> findEntitiesNamedInQuestion(Session session, String questionText) {\n        String lowerQuestion = questionText.toLowerCase();\n        List<Record> rows = session.run(\"\"\"\n                MATCH (e)\n                WHERE e:Product OR e:Feature OR e:Release OR e:Bug OR e:Customer OR e:Policy\n                RETURN elementId(e) AS id, coalesce(e.name, e.id, e.version) AS label\n                \"\"\").list();\n\n        Set<String> matches = new HashSet<>();\n        for (Record row : rows) {\n            String label = row.get(\"label\").asString(null);\n            if (label != null && label.length() > 2 && lowerQuestion.contains(label.toLowerCase())) {\n                matches.add(row.get(\"id\").asString());\n            }\n        }\n        return matches;\n    }\n\n    /** True if any entity a chunk MENTIONS is the named entity itself or within two hops of it. */\n    private boolean isNearNamedEntity(Session session, String chunkId, Set<String> namedEntityIds) {\n        return session.run(\"\"\"\n                MATCH (c:Chunk {id: $chunkId})-[:MENTIONS]->(entity)\n                MATCH path = (entity)-[*0..2]-(other)\n                WHERE elementId(other) IN $namedIds\n                RETURN count(*) > 0 AS found\n                \"\"\", Map.of(\"chunkId\", chunkId, \"namedIds\", List.copyOf(namedEntityIds)))\n                .single().get(\"found\").asBoolean();\n    }\n\n    /**\n     * Up to two-hop graph expansion from every entity a chunk MENTIONS.\n     * Two hops matters for facts like Bug -[REPORTS]- Ticket -[FILED_BY]- Customer --\n     * one hop only reaches the Ticket, never the Customer who actually filed it.\n     */\n    private String expandGraphFacts(Session session, String chunkId) {\n        List<Record> rows = session.run(\"\"\"\n                MATCH (c:Chunk {id: $chunkId})-[:MENTIONS]->(entity)\n                MATCH path = (entity)-[*1..2]-(other)\n                WHERE NONE(n IN nodes(path)[1..] WHERE n:Chunk OR n = entity)\n                RETURN entity, path\n                LIMIT 60\n                \"\"\", Map.of(\"chunkId\", chunkId)).list();\n\n        // Group facts by the entity so the LLM sees \"Bug X: fixed by Y, reported by Z\" rather than a flat list.\n        Map<String, Set<String>> factsByEntity = new LinkedHashMap<>();\n\n        for (Record row : rows) {\n            Node entity = row.get(\"entity\").asNode();\n            String entityLabel = describe(entity);\n            factsByEntity.computeIfAbsent(entityLabel, k -> new LinkedHashSet<>());\n\n            Path path = row.get(\"path\").asPath();\n            StringBuilder chain = new StringBuilder();\n            Node current = entity;\n            for (Path.Segment segment : path) {\n                Relationship rel = segment.relationship();\n                Node next = segment.start().elementId().equals(current.elementId()) ? segment.end() : segment.start();\n                boolean outgoing = rel.startNodeElementId().equals(current.elementId());\n                String arrow = outgoing ? \"-[\" + rel.type() + \"]->\" : \"<-[\" + rel.type() + \"]-\";\n                chain.append(chain.isEmpty() ? \"\" : \" \").append(arrow).append(\" \").append(describe(next));\n                current = next;\n            }\n\n            factsByEntity.get(entityLabel).add(chain.toString());\n        }\n\n        StringBuilder sb = new StringBuilder();\n        for (Map.Entry<String, Set<String>> entry : factsByEntity.entrySet()) {\n            sb.append(\"- \").append(entry.getKey()).append(\"\\n\");\n            for (String fact : entry.getValue()) {\n                sb.append(\"    \").append(fact).append(\"\\n\");\n            }\n        }\n        return sb.toString();\n    }\n\n    /** Turns a graph node into a short, readable, LLM-friendly description. */\n    private String describe(Node node) {\n        String label = node.labels().iterator().hasNext() ? node.labels().iterator().next() : \"Entity\";\n        Map<String, Object> props = node.asMap();\n\n        return switch (label) {\n            case \"Bug\" -> \"Bug %s (\\\"%s\\\") - severity: %s, status: %s\".formatted(\n                    props.get(\"id\"), props.get(\"title\"), props.get(\"severity\"), props.get(\"status\"));\n            case \"Release\" -> \"Release %s (released %s)\".formatted(props.get(\"version\"), props.get(\"releaseDate\"));\n            case \"Feature\" -> \"Feature: %s\".formatted(props.get(\"name\"));\n            case \"Product\" -> \"Product: %s\".formatted(props.get(\"name\"));\n            case \"Customer\" -> \"Customer %s (tier: %s)\".formatted(props.get(\"name\"), props.get(\"tier\"));\n            case \"Ticket\" -> \"Ticket %s (status: %s, filed %s)\".formatted(\n                    props.get(\"id\"), props.get(\"status\"), props.get(\"createdDate\"));\n            case \"Policy\" -> \"Policy \\\"%s\\\": %s\".formatted(props.get(\"name\"), props.get(\"text\"));\n            default -> label + \" \" + props;\n        };\n    }\n}\n","structuredPatch":[{"oldStart":131,"oldLines":8,"newStart":131,"newLines":8,"lines":["     private String expandGraphFacts(Session session, String chunkId) {","         List<Record> rows = session.run(\"\"\"","                 MATCH (c:Chunk {id: $chunkId})-[:MENTIONS]->(entity)","-                MATCH path = (entity)-[*1..2]-(other)","-                WHERE NONE(n IN nodes(path)[1..] WHERE n:Chunk OR n = entity)","+                OPTIONAL MATCH path = (entity)-[*1..2]-(other)","+                WHERE path IS NULL OR NONE(n IN nodes(path)[1..] WHERE n:Chunk OR n = entity)","                 RETURN entity, path","                 LIMIT 60","                 \"\"\", Map.of(\"chunkId\", chunkId)).list();"]},{"oldStart":145,"oldLines":7,"newStart":145,"newLines":11,"lines":["             Stri