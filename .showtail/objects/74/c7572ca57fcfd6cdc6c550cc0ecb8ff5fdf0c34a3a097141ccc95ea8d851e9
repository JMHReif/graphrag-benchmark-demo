{"sequence":125,"type":"tool_use","sourceId":"conversation:toolu_01VHA1JTaZg7TmTJANdhAcL3:use","timestamp":"2026-09-29T19:06:20.569Z","toolUseId":"toolu_01VHA1JTaZg7TmTJANdhAcL3","toolName":"Edit","input":{"replace_all":false,"file_path":"/Users/jenniferreif/Projects/graphrag-benchmark-demo/src/main/java/com/neo4j/webinar/retrieval/GraphRagContentRetriever.java","old_string":"import java.util.ArrayList;\nimport java.util.LinkedHashMap;\nimport java.util.LinkedHashSet;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Set;\n\n/**\n * The GraphRAG retriever: this is the piece that turns plain vector RAG into\n * *graph* RAG.\n *\n * <pre>\n *   1. Embed the question.\n *   2. Vector search over :Chunk.embedding to find the most relevant\n *      free-text passages (\"seed\" nodes) -- this is exactly what a\n *      vector-only pipeline would stop at.\n *   3. For each seed chunk, walk up to two hops out through the graph\n *      (Chunk -[:MENTIONS]-> entity -[any]- ... ) to pull in connected\n *      facts a text chunk alone can't express: which release fixed a bug,\n *      which customers reported it (Bug -> Ticket -> Customer is two hops),\n *      whether it's still open, etc.\n *   4. Return chunk text + graph facts together as retrieved Content.\n * </pre>\n */\npublic class GraphRagContentRetriever implements ContentRetriever {\n\n    private static final String VECTOR_INDEX = \"chunkEmbeddings\";\n\n    private final Driver driver;\n    private final EmbeddingModel embeddingModel;\n    private final int maxSeedChunks;\n\n    public GraphRagContentRetriever(Driver driver, EmbeddingModel embeddingModel, int maxSeedChunks) {\n        this.driver = driver;\n        this.embeddingModel = embeddingModel;\n        this.maxSeedChunks = maxSeedChunks;\n    }\n\n    @Override\n    public List<Content> retrieve(Query query) {\n        Embedding queryEmbedding = embeddingModel.embed(query.text()).content();\n        List<Content> contents = new ArrayList<>();\n\n        try (Session session = driver.session()) {\n            List<Record> seeds = session.run(\"\"\"\n                    CALL db.index.vector.queryNodes($indexName, $k, $queryVector)\n                    YIELD node, score\n                    RETURN node.id AS id, node.text AS text, score\n                    \"\"\", Map.of(\n                    \"indexName\", VECTOR_INDEX,\n                    \"k\", maxSeedChunks,\n                    \"queryVector\", queryEmbedding.vectorAsList()\n            )).list();\n\n            for (Record seed : seeds) {\n                String chunkId = seed.get(\"id\").asString();\n                String chunkText = seed.get(\"text\").asString();\n                String graphFacts = expandGraphFacts(session, chunkId);\n\n                String combined = \"Source passage [\" + chunkId + \"]: \" + chunkText +\n                        (graphFacts.isBlank() ? \"\" : \"\\nRelated graph facts:\\n\" + graphFacts);\n\n                contents.add(Content.from(combined));\n            }\n        }\n        return contents;\n    }","new_string":"import java.util.ArrayList;\nimport java.util.HashSet;\nimport java.util.LinkedHashMap;\nimport java.util.LinkedHashSet;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Set;\n\n/**\n * The GraphRAG retriever: this is the piece that turns plain vector RAG into\n * *graph* RAG.\n *\n * <pre>\n *   1. Embed the question.\n *   2. Vector search over :Chunk.embedding for a candidate pool slightly\n *      wider than what we'll actually use -- this is exactly what a\n *      vector-only pipeline would stop at.\n *   3. If the question names something that's actually in the graph (a\n *      product, feature, release, bug, customer, or policy), use the graph\n *      to drop candidates that aren't within two hops of it -- e.g. a\n *      question naming \"Aurora\" shouldn't pull in a Beacon release note\n *      just because it scored well on vector similarity. If nothing in the\n *      question matches a graph entity, keep the vector ranking as-is.\n *   4. For each surviving seed chunk, walk up to two hops out through the\n *      graph (Chunk -[:MENTIONS]-> entity -[any]- ...) to pull in connected\n *      facts a text chunk alone can't express: which release fixed a bug,\n *      which customers reported it (Bug -> Ticket -> Customer is two hops),\n *      whether it's still open, etc.\n *   5. Return chunk text + graph facts together as retrieved Content.\n * </pre>\n */\npublic class GraphRagContentRetriever implements ContentRetriever {\n\n    private static final String VECTOR_INDEX = \"chunkEmbeddings\";\n\n    private final Driver driver;\n    private final EmbeddingModel embeddingModel;\n    private final int maxSeedChunks;\n\n    public GraphRagContentRetriever(Driver driver, EmbeddingModel embeddingModel, int maxSeedChunks) {\n        this.driver = driver;\n        this.embeddingModel = embeddingModel;\n        this.maxSeedChunks = maxSeedChunks;\n    }\n\n    @Override\n    public List<Content> retrieve(Query query) {\n        Embedding queryEmbedding = embeddingModel.embed(query.text()).content();\n        List<Content> contents = new ArrayList<>();\n\n        try (Session session = driver.session()) {\n            List<Record> candidates = session.run(\"\"\"\n                    CALL db.index.vector.queryNodes($indexName, $k, $queryVector)\n                    YIELD node, score\n                    RETURN node.id AS id, node.text AS text, score\n                    \"\"\", Map.of(\n                    \"indexName\", VECTOR_INDEX,\n                    \"k\", maxSeedChunks + 2,\n                    \"queryVector\", queryEmbedding.vectorAsList()\n            )).list();\n\n            Set<String> namedEntityIds = findEntitiesNamedInQuestion(session, query.text());\n            List<Record> filtered = namedEntityIds.isEmpty()\n                    ? candidates\n                    : candidates.stream().filter(c -> isNearNamedEntity(session, c.get(\"id\").asString(), namedEntityIds)).toList();\n            List<Record> seeds = (filtered.isEmpty() ? candidates : filtered).stream().limit(maxSeedChunks).toList();\n\n            for (Record seed : seeds) {\n                String chunkId = seed.get(\"id\").asString();\n                String chunkText = seed.get(\"text\").asString();\n                String graphFacts = expandGraphFacts(session, chunkId);\n\n                String combined = \"Source passage [\" + chunkId + \"]: \" + chunkText +\n                        (graphFacts.isBlank() ? \"\" : \"\\nRelated graph facts:\\n\" + graphFacts);\n\n                contents.add(Content.from(combined));\n            }\n        }\n        return contents;\n    }\n\n    /** Finds graph entities whose name/id/version is literally named in the question text. */\n    private Set<String> findEntitiesNamedInQuestion(Session session, String questionText) {\n        String lowerQuestion = questionText.toLowerCase();\n        List<Record> rows = session.run(\"\"\"\n                MATCH (e)\n                WHERE e:Product OR e:Feature OR e:Release OR e:Bug OR e:Customer OR e:Policy\n                RETURN elementId(e) AS id, coalesce(e.name, e.id, e.version) AS label\n                \"\"\").list();\n\n        Set<String> matches = new HashSet<>();\n        for (Record row : rows) {\n            String label = row.get(\"label\").asString(null);\n            if (label != null && label.length() > 2 && lowerQuestion.contains(label.toLowerCase())) {\n                matches.add(row.get(\"id\").asString());\n            }\n        }\n        return matches;\n    }\n\n    /** True if any entity a chunk MENTIONS is the named entity itself or within two hops of it. */\n    private boolean isNearNamedEntity(Session session, String chunkId, Set<String> namedEntityIds) {\n        return session.run(\"\"\"\n                MATCH (c:Chunk {id: $chunkId})-[:MENTIONS]->(entity)\n                MATCH path = (entity)-[*0..2]-(other)\n                WHERE elementId(other) IN $namedIds\n                RETURN count(*) > 0 AS found\n                \"\"\", Map.of(\"chunkId\", chunkId, \"namedIds\", List.copyOf(namedEntityIds)))\n                .single().get(\"found\").asBoolean();\n    }"}}