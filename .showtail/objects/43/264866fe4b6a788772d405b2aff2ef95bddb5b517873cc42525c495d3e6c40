26	public class VectorOnlyContentRetriever implements ContentRetriever {
27	
28	    private static final String VECTOR_INDEX = "chunkEmbeddings";
29	
30	    private final Driver driver;
31	    private final EmbeddingModel embeddingModel;
32	    private final int maxSeedChunks;
33	
34	    public VectorOnlyContentRetriever(Driver driver, EmbeddingModel embeddingModel, int maxSeedChunks) {
35	        this.driver = driver;
36	        this.embeddingModel = embeddingModel;
37	        this.maxSeedChunks = maxSeedChunks;
38	    }
39	
40	    @Override
41	    public List<Content> retrieve(Query query) {
42	        Embedding queryEmbedding = embeddingModel.embed(query.text()).content();
43	
44	        try (Session session = driver.session()) {
45	            List<Record> seeds = session.run("""
46	                    CALL db.index.vector.queryNodes($indexName, $k, $queryVector)
47	                    YIELD node, score
48	                    RETURN node.text AS text, score
49	                    """, Map.of(
50	                    "indexName", VECTOR_INDEX,
51	                    "k", maxSeedChunks,
52	                    "queryVector", queryEmbedding.vectorAsList()
53	            )).list();
54	
55	            return seeds.stream()
56	                    .map(r -> Content.from(r.get("text").asString()))
57	                    .collect(Collectors.toList());
58	        }
59	    }
60	}
