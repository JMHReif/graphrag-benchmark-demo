{"sequence":6,"type":"tool_result","sourceId":"conversation:toolu_01R6qWxZvekPwGyvYE3u28CW:result","timestamp":"2026-09-29T16:11:11.986Z","toolUseId":"toolu_01R6qWxZvekPwGyvYE3u28CW","content":{"type":"text","file":{"filePath":"/Users/jenniferreif/Projects/graphrag-benchmark-demo/pom.xml","content":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<project xmlns=\"http://maven.apache.org/POM/4.0.0\"\n         xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n\n    <groupId>com.neo4j.webinar</groupId>\n    <artifactId>graphrag-benchmark-demo</artifactId>\n    <version>1.0.0</version>\n    <packaging>jar</packaging>\n\n    <name>GraphRAG Benchmark Demo</name>\n    <description>\n        Companion demo for the \"Benchmarking RAG for Accuracy\" webinar.\n        Builds a small GraphRAG pipeline over a support-ticket knowledge graph\n        in Neo4j using LangChain4j, then scores it against a benchmark of\n        question types with an LLM-as-judge harness.\n    </description>\n\n    <properties>\n        <maven.compiler.source>17</maven.compiler.source>\n        <maven.compiler.target>17</maven.compiler.target>\n        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>\n\n        <!--\n          Versions below were the latest available on Maven Central as of\n          September 2026. langchain4j-community-* modules are still shipping\n          as betas and move fast, so before your session, double check:\n            https://central.sonatype.com/artifact/dev.langchain4j/langchain4j-bom\n            https://central.sonatype.com/artifact/dev.langchain4j/langchain4j-community-neo4j\n            https://central.sonatype.com/artifact/dev.langchain4j/langchain4j-community-neo4j-retriever\n          and bump these properties if newer versions exist. A version\n          mismatch between langchain4j core and langchain4j-community is the\n          most common source of NoSuchMethodError at runtime.\n        -->\n        <langchain4j.version>1.12.2</langchain4j.version>\n        <langchain4j.community.version>1.20.0-beta30</langchain4j.community.version>\n        <neo4j.driver.version>5.28.4</neo4j.driver.version>\n        <jackson.version>2.18.2</jackson.version>\n    </properties>\n\n    <dependencyManagement>\n        <dependencies>\n            <dependency>\n                <groupId>dev.langchain4j</groupId>\n                <artifactId>langchain4j-bom</artifactId>\n                <version>${langchain4j.version}</version>\n                <type>pom</type>\n                <scope>import</scope>\n            </dependency>\n        </dependencies>\n    </dependencyManagement>\n\n    <dependencies>\n        <!-- Core LangChain4j: ChatModel / EmbeddingModel / AiServices / RAG abstractions -->\n        <dependency>\n            <groupId>dev.langchain4j</groupId>\n            <artifactId>langchain4j</artifactId>\n        </dependency>\n\n        <!-- LLM + embedding provider used for the demo. Swap for another\n             langchain4j-<provider> module (azure-open-ai, ollama, bedrock, ...)\n             if you're not using OpenAI. -->\n        <dependency>\n            <groupId>dev.langchain4j</groupId>\n            <artifactId>langchain4j-open-ai</artifactId>\n        </dependency>\n\n        <!-- Neo4j vector store (used for the vector-seed step of GraphRAG) -->\n        <dependency>\n            <groupId>dev.langchain4j</groupId>\n            <artifactId>langchain4j-community-neo4j</artifactId>\n            <version>${langchain4j.community.version}</version>\n        </dependency>\n\n        <!-- Plain Neo4j Java Driver, used directly for graph seeding and\n             for the Cypher graph-expansion step of the GraphRAG retriever. -->\n        <dependency>\n            <groupId>org.neo4j.driver</groupId>\n            <artifactId>neo4j-java-driver</artifactId>\n            <version>${neo4j.driver.version}</version>\n        </dependency>\n\n        <!-- JSON parsing for the benchmark question set -->\n        <dependency>\n            <groupId>com.fasterxml.jackson.core</groupId>\n            <artifactId>jackson-databind</artifactId>\n            <version>${jackson.version}</version>\n        </dependency>\n    </dependencies>\n\n    <build>\n        <finalName>graphrag-benchmark-demo</finalName>\n        <plugins>\n            <plugin>\n                <groupId>org.apache.maven.plugins</groupId>\n                <artifactId>maven-compiler-plugin</artifactId>\n                <version>3.13.0</version>\n            </plugin>\n            <plugin>\n                <groupId>org.codehaus.mojo</groupId>\n                <artifactId>exec-maven-plugin</artifactId>\n                <version>3.4.1</version>\n                <configuration>\n                    <mainClass>com.neo4j.webinar.Main</mainClass>\n                </configuration>\n            </plugin>\n            <!-- Shade plugin so `java -jar` works without a classpath dance\n                 during the live demo. -->\n            <plugin>\n                <groupId>org.apache.maven.plugins</groupId>\n                <artifactId>maven-shade-plugin</artifactId>\n                <version>3.6.0</version>\n                <executions>\n                    <execution>\n                        <phase>package</phase>\n                        <goals>\n                            <goal>shade</goal>\n                        </goals>\n                        <configuration>\n                            <transformers>\n                                <transformer implementation=\"org.apache.maven.plugins.shade.resource.ManifestResourceTransformer\">\n                                    <mainClass>com.neo4j.webinar.Main</mainClass>\n                                </transformer>\n                            </transformers>\n                        </configuration>\n                    </execution>\n                </executions>\n            </plugin>\n        </plugins>\n    </build>\n</project>\n","numLines":133,"startLine":1,"totalLines":133}}}